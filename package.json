{
  "name": "procode",
  "version": "0.2.3",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/generate-themes.mjs && node scripts/prepare-runtime.mjs && node scripts/prepare-angular.mjs && ng serve --host 127.0.0.1",
    "build": "node scripts/generate-themes.mjs && node scripts/prepare-runtime.mjs && node scripts/prepare-angular.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "postinstall": "node scripts/prepare-runtime.mjs && node scripts/prepare-angular.mjs",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve.mjs",
    "themes": "node scripts/generate-themes.mjs",
    "test:fullstack-router": "node --test scripts/fullstack-runtime/router.test.mjs",
    "test:crud-api": "node --test --import @angular/compiler scripts/angular-runtime/contacts-api.test.mjs",
    "desktop:icon": "node scripts/desktop-icon.mjs",
    "desktop:icon:windows": "node scripts/windows-icon.mjs",
    "desktop:bundle": "node scripts/package-macos.mjs",
    "test:desktop-assets": "node --test desktop/assets.test.cjs",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "package:mac": "npm run build && npm run test:desktop-assets && npm run desktop:bundle && npm run test:desktop && node scripts/create-dmg.mjs",
    "package:windows": "npm run build && npm run test:desktop-assets && node scripts/package-windows.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "pyodide": "314.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.63.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
